amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

local checks = new Mapping {
  ["rust-fmt-check"] = new Step {
    glob = "**/*.rs"
    check = new CommandSpec {
      command = "cargo make rust-fmt-check"
      effect = "read"
    }
  }
  ["lint"] = new Step {
    glob = "**/*.rs"
    check = new CommandSpec {
      command = "cargo make lint"
      effect = "read"
    }
  }
  ["md-check"] = new Step {
    glob = "**/*.md"
    check = new CommandSpec {
      command = "cargo make md-check"
      effect = "read"
    }
  }
  ["header-check-sources"] = new Step {
    glob = "**/*.rs"
    check = new CommandSpec {
      command = "cargo make header-check"
      effect = "read"
    }
  }
  ["header-check-header"] = new Step {
    glob = "include/colander.h"
    check = new CommandSpec {
      command = "cargo make header-check"
      effect = "read"
    }
  }
}

hooks {
  ["check"] {
    steps = checks
  }
  ["commit-msg"] {
    steps {
      # `scripts/check-conventional-commit.sh` is gone: its only real gate was hk's own
      # validator plus a file-based vocabulary, and hk ships that validator. The step keeps the
      # name `conventional-commit` so the hook output still reads the way it did.
      #
      # The type list is spelled out because `hk.pkl` cannot read a file. It is the
      # third record of the same nine types: `policy.yml`'s `branch-types`, the
      # nine `title-types` that are also commit types, and this
      # `--allowed-types`. Change one and mirror the other two.
      #
      # The distinction this line exists to record: it mirrors the *title*
      # vocabulary, not the `type/*` label family. A commit type is `feat`, never
      # `type/feature`.
      #
      # Nine, not ten: `breaking-change` is a title type this repository accepts,
      # but not a commit type anyone writes. A breaking commit says `feat!:` or
      # `fix!:` with a `BREAKING CHANGE:` footer, which is what release-please
      # reads to compute a bump.
      ["conventional-commit"] = new Step {
        check = new CommandSpec {
          command = "hk util check-conventional-commit --allowed-types \"feat,fix,docs,chore,refactor,test,ci,build,perf\" {{commit_msg_file}}"
          effect = "read"
        }
      }
    }
  }
  ["pre-commit"] {
    steps = checks
  }
  ["pre-push"] {
    steps {
      ["test"] = new Step {
        glob = "**/*.rs"
        check = new CommandSpec {
          command = "cargo make test"
          effect = "read"
        }
      }
    }
  }
}
